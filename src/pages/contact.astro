---
import Layout from '../layouts/Layout.astro';
---

<Layout
    title="Contact | Hire a Freelance Web Developer in London"
    description="Available for freelance/contract front end development work — remote, hybrid or on-site. Get in touch to discuss your next project.">
    <section class="section">
        <div class="container">
            <div class="grid">
                <div class="grid-item grid-item--8 flow">
                    <h1 class="">Contact</h1>
                    <p class="text-xxl">
                        I'm based in London and available for remote, hybrid or on site projects. Get in touch using the links below to discuss how I can help
                        you.
                    </p>
                    <p class="text-lg">Available for contracts/projects starting August 2026.</p>
                    <ul role="list" class="contact-list text-lg">
                        <li class="contact-list__item">
                            <a href="mailto:simon.morgan80@gmail.com" class="contact-list__link"> Email </a>
                        </li>
                        <li class="contact-list__item">
                            <a href="https://www.linkedin.com/in/simon-morgan-5b842414" target="_blank" rel="noreferrer" class="contact-list__link">Linkedin</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>
</Layout>
